{
  "expo": {
    "name": "Vidlun",
    "slug": "vidlun",
    "version": "1.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.vidlun.journal",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production",
        "com.apple.developer.default-data-protection": "NSFileProtectionCompleteUnlessOpen"
      },
      "infoPlist": {
        "NSFaceIDUsageDescription": "Face ID opens Vidlun when the journal lock is on, so nobody else holding your phone can read your entries.",
        "ITSAppUsesNonExemptEncryption": false,
        "RCTAsyncStorageExcludeFromBackup": false
      },
      "buildNumber": "73",
      "appleTeamId": "M3K99W5FFQ"
    },
    "android": {
      "package": "com.vidlun.journal",
      "adaptiveIcon": {
        "backgroundColor": "#EDF2F1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Vidlun uses the microphone only while you’re recording. Your words are recognized on your device, and the recording stays in your journal so you can listen to it again.",
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Unbounded-Regular.ttf",
            "./assets/fonts/Unbounded-Medium.ttf",
            "./assets/fonts/IBMPlexSans-Regular.ttf",
            "./assets/fonts/IBMPlexSans-Medium.ttf",
            "./assets/fonts/IBMPlexSans-SemiBold.ttf"
          ]
        }
      ],
      "expo-localization",
      "expo-notifications",
      "@bacons/apple-targets",
      [
        "./plugins/withBundledModel",
        {
          "file": "assets/model/ggml-parakeet-ultra-0.6b-q4_0.bin"
        }
      ],
      "./plugins/withSceneDelegate"
    ],
    "scheme": "vidlun",
    "locales": {
      "uk": "./locales/uk.json",
      "en": "./locales/en.json"
    }
  }
}
